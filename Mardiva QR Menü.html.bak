<!DOCTYPE html>
<html lang="tr" dir="ltr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#232528">
<title>Mardiva</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Jost:wght@300;400;500&family=Noto+Kufi+Arabic:wght@300;400;500&family=Noto+Naskh+Arabic:wght@500;600&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#232528;
  --raise:#2c2e32;
  --line:rgba(236,237,239,.1);
  --text:#eceef0;
  --muted:#9fa4ab;
  --accent:#cdbb98;
  --serif:'Cormorant Garamond','Noto Naskh Arabic',Georgia,'Times New Roman',serif;
  --sans:'Jost','Noto Kufi Arabic',system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;
  --nav-h:54px;
  color-scheme:dark;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
}
html{scroll-padding-top:env(safe-area-inset-top,0px);background:var(--bg);-webkit-text-size-adjust:100%}
*,*::before,*::after{box-sizing:inherit}
body{margin:0;background:var(--bg);color:var(--text);font-family:var(--sans);font-weight:400;font-size:16px;line-height:1.5;-webkit-font-smoothing:antialiased}
[dir=rtl] body{line-height:1.8}
button{font:inherit;color:inherit}
:focus-visible{outline:2px solid var(--accent);outline-offset:3px;border-radius:4px}

/* Hero */
.hero{position:relative;overflow:hidden;padding:60px 24px 34px;text-align:center}
.hero::before{content:"";position:absolute;width:400px;height:460px;right:-120px;top:-90px;background:url(data:image/png;base64,) center/contain no-repeat;opacity:.055;pointer-events:none}
[dir=rtl] .hero::before{right:auto;left:-120px}
.logo{position:relative;display:block;width:min(252px,66vw);height:auto;margin:0 auto;animation:settle 1.2s cubic-bezier(.2,.7,.2,1) both}
@keyframes settle{from{opacity:0;transform:scale(.97)}to{opacity:1;transform:none}}
.title{position:relative;margin:24px 0 0;font-family:var(--serif);font-weight:500;font-size:26px;line-height:1.2;color:var(--muted)}

.lang{position:relative;display:inline-flex;gap:2px;margin-top:26px;padding:3px;border:1px solid var(--line);border-radius:999px}
.lang button{min-width:52px;height:36px;padding:0 14px;border:0;border-radius:999px;background:none;color:var(--muted);font-size:14px;font-weight:500;cursor:pointer;transition:background .2s,color .2s}
.lang button[aria-pressed=true]{background:rgba(236,238,240,.09);color:var(--text)}

/* Category nav */
.nav{position:sticky;top:env(safe-area-inset-top,0px);z-index:10;background:rgba(35,37,40,.9);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.nav-scroll{display:flex;max-width:680px;margin:0 auto;padding:0 10px;overflow-x:auto;scrollbar-width:none}
.nav-scroll::-webkit-scrollbar{display:none}
.chip{position:relative;flex:none;padding:18px 14px 16px;border:0;background:none;color:var(--muted);font-size:15px;line-height:1.2;white-space:nowrap;cursor:pointer;transition:color .2s}
.chip::after{content:"";position:absolute;inset-inline:14px;bottom:0;height:2px;background:var(--accent);transform:scaleX(0);transition:transform .25s ease}
.chip[aria-current=true]{color:var(--text)}
.chip[aria-current=true]::after{transform:scaleX(1)}

/* Menu */
main{max-width:680px;margin:0 auto;padding:0 24px}
.cat{padding-top:52px;scroll-margin-top:calc(var(--nav-h) + env(safe-area-inset-top,0px) + 4px)}
.cat h2{margin:0 0 8px;font-family:var(--serif);font-weight:500;font-size:38px;line-height:1.1;letter-spacing:.005em}
.item{display:grid;grid-template-columns:1fr auto;column-gap:20px;row-gap:5px;padding:19px 0;border-bottom:1px solid var(--line)}
.item:last-child{border-bottom:0}
.name{font-size:17px;font-weight:500;line-height:1.35}
.price{font-size:17px;font-weight:400;color:var(--accent);font-variant-numeric:tabular-nums;white-space:nowrap}
.desc{grid-column:1;max-width:44ch;margin:0;font-size:14.5px;font-weight:300;line-height:1.55;color:var(--muted)}
[dir=rtl] .desc{font-size:14px;line-height:1.85}
.tags{grid-column:1 / -1;display:flex;flex-wrap:wrap;gap:6px;margin-top:6px}
.tag{padding:2px 10px;border:1px solid var(--line);border-radius:999px;font-size:12px;line-height:1.6;color:var(--muted)}
.tag.chef{border-color:rgba(205,187,152,.45);color:var(--accent)}

/* Footer */
footer{padding:64px 24px 56px;text-align:center}
footer img{width:116px;height:auto;opacity:.65}
footer p{max-width:36ch;margin:18px auto 0;font-size:13px;font-weight:300;line-height:1.7;color:var(--muted)}
[dir=rtl] footer p{line-height:1.9}

@media (min-width:700px){
  .hero{padding-top:84px}
  .cat h2{font-size:44px}
}
@media (prefers-reduced-motion:reduce){
  .logo{animation:none}
  .chip::after,.chip,.lang button{transition:none}
}
</style>
</head>
<body>

<header class="hero">
  <img class="logo" alt="Mardiva" src="data:image/png;base64,">
  <h1 class="title" id="title">Menü</h1>
  <div class="lang" role="group" aria-label="Language">
    <button type="button" data-lang="tr">TR</button>
    <button type="button" data-lang="en">EN</button>
    <button type="button" data-lang="ar" lang="ar">عربي</button>
  </div>
</header>

<nav class="nav" aria-label="Menu">
  <div class="nav-scroll" id="navScroll"></div>
</nav>

<main id="menu"></main>

<footer>
  <img alt="" src="data:image/png;base64,">
  <p id="note1"></p>
  <p id="note2"></p>
</footer>

<script>
(function(){
  var UI = {
    tr:{menu:"Menü",spicy:"Acılı",veg:"Vejetaryen",chef:"Şefin önerisi",n1:"Fiyatlara KDV dahildir.",n2:"Alerjiniz varsa sipariş vermeden önce servis ekibimize bildirin."},
    en:{menu:"Menu",spicy:"Spicy",veg:"Vegetarian",chef:"Chef's pick",n1:"Prices include VAT.",n2:"If you have an allergy, please tell our team before ordering."},
    ar:{menu:"القائمة",spicy:"حار",veg:"نباتي",chef:"اختيار الشيف",n1:"الأسعار تشمل ضريبة القيمة المضافة.",n2:"إذا كان لديك حساسية، يرجى إبلاغ فريق الخدمة قبل الطلب."}
  };

  /* ===== MENÜ VERİSİ — örnek içerik, kendi ürün ve fiyatlarınızla değiştirin ===== */
  var MENU = [
    {id:"starters",name:{tr:"Başlangıçlar",en:"Starters",ar:"المقبلات"},items:[
      {p:190,chef:1,tr:["Sembusek","Kıymalı ve soğanlı, çıtır hamurlu Mardin böreği"],en:["Sembusek","Crisp Mardin pastry filled with spiced minced lamb and onion"],ar:["سمبوسك","عجينة ماردينية مقرمشة محشوة باللحم المفروم المتبّل والبصل"]},
      {p:210,tr:["İçli Köfte","Bulgur hamuruna sarılı kıyma ve ceviz içi"],en:["Stuffed Bulgur Kibbeh","Bulgur shell filled with minced meat and walnut"],ar:["كبة محشوة","كبة برغل محشوة باللحم المفروم والجوز"]},
      {p:140,tags:["spicy","veg"],tr:["Acılı Ezme","Domates, soğan, maydanoz ve nar ekşisi"],en:["Spicy Ezme","Tomato, onion, parsley and pomegranate molasses"],ar:["إزمة حارة","طماطم وبصل وبقدونس مع دبس الرمان"]},
      {p:150,tags:["veg"],tr:["Humus","Nohut, tahin ve zeytinyağı"],en:["Hummus","Chickpeas, tahini and olive oil"],ar:["حمص","حمص وطحينة وزيت زيتون"]},
      {p:165,tags:["veg"],tr:["Közlenmiş Patlıcan","Közde pişmiş patlıcan, sarımsaklı yoğurt ve nar ekşisi"],en:["Charred Aubergine","Fire-roasted aubergine with garlic yoghurt and pomegranate molasses"],ar:["باذنجان مشوي","باذنجان مشوي على الجمر مع لبن بالثوم ودبس الرمان"]}
    ]},
    {id:"soups",name:{tr:"Çorbalar",en:"Soups",ar:"الشوربات"},items:[
      {p:120,tags:["veg"],tr:["Mercimek Çorbası","Süzme kırmızı mercimek, limon ve tereyağında kızdırılmış pul biber"],en:["Lentil Soup","Silky red lentil soup with lemon and butter-fried chili flakes"],ar:["شوربة العدس","عدس أحمر ناعم مع الليمون وزيت الفلفل بالزبدة"]},
      {p:130,tags:["veg"],tr:["Yayla Çorbası","Pirinç, yoğurt ve kuru nane"],en:["Yayla Soup","Warm yoghurt soup with rice and dried mint"],ar:["شوربة اللبن","لبن دافئ مع الأرز والنعناع المجفف"]}
    ]},
    {id:"grill",name:{tr:"Izgaralar",en:"From the Grill",ar:"المشاويات"},items:[
      {p:520,chef:1,tr:["Urfa Kebap","Acısız, el kıyması kuzu; közlenmiş domates, biber ve lavaş"],en:["Urfa Kebab","Mild hand-minced lamb with charred tomato, pepper and lavash"],ar:["كباب أورفا","لحم ضأن مفروم يدويًا غير حار مع طماطم وفلفل مشويين وخبز لافاش"]},
      {p:520,tags:["spicy"],tr:["Adana Kebap","Acılı kuzu kıyma, kuyruk yağı, közlenmiş biber ve sumaklı soğan"],en:["Adana Kebab","Spicy minced lamb with tail fat, charred pepper and sumac onions"],ar:["كباب أضنة","لحم ضأن مفروم حار مع شحم الألية وفلفل مشوي وبصل بالسماق"]},
      {p:640,tr:["Kuzu Şiş","Marine kuzu bonfile, ızgara sebze ve bulgur pilavı"],en:["Lamb Skewers","Marinated lamb tenderloin with grilled vegetables and bulgur pilaf"],ar:["شيش ضأن","فيليه ضأن متبّل مع خضار مشوية وأرز البرغل"]},
      {p:580,tr:["Beyti","Lavaşa sarılı kuzu kıyma, domates sosu ve süzme yoğurt"],en:["Beyti","Minced lamb wrapped in lavash, with tomato sauce and strained yoghurt"],ar:["بيتي","لحم ضأن مفروم ملفوف بخبز اللافاش مع صلصة الطماطم واللبن المصفى"]},
      {p:440,tr:["Tavuk Şiş","Yoğurtlu marine tavuk but, pilav ve közlenmiş biber"],en:["Chicken Skewers","Yoghurt-marinated chicken thigh with pilaf and charred pepper"],ar:["شيش طاووق","فخذ دجاج متبّل باللبن مع الأرز وفلفل مشوي"]},
      {p:1280,tr:["Karışık Izgara","Kuzu şiş, kebap, pirzola ve tavuk; iki kişilik"],en:["Mixed Grill","Lamb skewer, kebab, chop and chicken; serves two"],ar:["مشاوي مشكلة","سيخ ضأن وكباب وريش ودجاج؛ تكفي شخصين"]}
    ]},
    {id:"mardin",name:{tr:"Mardin Mutfağı",en:"Mardin Kitchen",ar:"المطبخ الماردينيّ"},items:[
      {p:760,chef:1,tr:["Kaburga Dolması","Pirinç, kıyma ve baharatla doldurulmuş kuzu kaburga; saatlerce yavaş pişirilir"],en:["Stuffed Lamb Ribs","Lamb ribs filled with spiced rice and mince, slow-cooked for hours"],ar:["ضلوع الضأن المحشية","ضلوع ضأن محشوة بالأرز واللحم المفروم والبهارات، تُطهى ببطء لساعات"]},
      {p:380,tr:["Ekşili Köfte","Bulgurlu köfte ve nohut, limonlu ekşimsi sos"],en:["Sour Kofte Stew","Bulgur meatballs and chickpeas in a lemony broth"],ar:["كفتة بالحامض","كفتة بالبرغل والحمص في مرق الليمون"]},
      {p:420,tr:["Alluciye","Kuzu eti, kuru erik ve badem ile ekşi-tatlı yahni"],en:["Alluciye","Slow-cooked lamb with dried plums and almonds in a sweet-sour sauce"],ar:["ألوجية","لحم ضأن مطهو ببطء مع البرقوق المجفف واللوز بصلصة حلوة وحامضة"]}
    ]},
    {id:"oven",name:{tr:"Fırından",en:"From the Oven",ar:"من الفرن"},items:[
      {p:160,tags:["spicy"],tr:["Lahmacun","İnce hamurda baharatlı kıyma; maydanoz ve limonla"],en:["Lahmacun","Thin crust with spiced mince, parsley and lemon"],ar:["لحم بعجين","عجينة رقيقة مع لحم مفروم متبّل وبقدونس وليمون"]},
      {p:360,tr:["Kuşbaşılı Pide","Kuşbaşı kuzu eti ve tereyağı"],en:["Diced Lamb Pide","Diced lamb and butter on baked flatbread"],ar:["بيدا باللحم المقطّع","لحم ضأن مقطّع مع الزبدة على عجينة مخبوزة"]},
      {p:290,tags:["veg"],tr:["Peynirli Pide","Kaşar ve beyaz peynir, tereyağı"],en:["Cheese Pide","Kashar and white cheese with butter"],ar:["بيدا بالجبنة","جبنة كشكوان وجبنة بيضاء مع الزبدة"]}
    ]},
    {id:"dessert",name:{tr:"Tatlılar",en:"Desserts",ar:"الحلويات"},items:[
      {p:260,chef:1,tags:["veg"],tr:["Künefe","Hatay peyniri, çıtır tel kadayıf, şerbet ve Antep fıstığı"],en:["Kunafa","Melted cheese under crisp shredded pastry, syrup and pistachio"],ar:["كنافة","جبنة ذائبة تحت عجينة الكنافة المقرمشة مع القطر والفستق"]},
      {p:290,tags:["veg"],tr:["Fıstıklı Baklava","Çıtır yufka katları ve Antep fıstığı; dört dilim"],en:["Pistachio Baklava","Four pieces of flaky pastry layered with Antep pistachio"],ar:["بقلاوة بالفستق","أربع قطع من العجين الهش بطبقات الفستق الحلبي"]},
      {p:240,tags:["veg"],tr:["Kaymaklı Ekmek Kadayıfı","Şerbetli ekmek kadayıfı, bol kaymak ve toz fıstık"],en:["Bread Kadayif","Syrup-soaked kadayif with thick clotted cream and ground pistachio"],ar:["قطايف الخبز بالقشطة","قطايف مشبّعة بالقطر مع قشطة كثيفة وفستق مطحون"]}
    ]},
    {id:"drinks",name:{tr:"İçecekler",en:"Drinks",ar:"المشروبات"},items:[
      {p:90,chef:1,tr:["Mırra","Kardamomlu, yoğun ve acı Mardin kahvesi"],en:["Mırra","Strong, bitter Mardin coffee with cardamom"],ar:["مِرّة","قهوة ماردين المرّة الكثيفة بالهيل"]},
      {p:85,tr:["Türk Kahvesi","Sade, orta veya şekerli"],en:["Turkish Coffee","Plain, medium or sweet"],ar:["قهوة تركية","سادة أو وسط أو سكر زيادة"]},
      {p:35,tr:["Çay","İnce belli bardakta demli çay"],en:["Tea","Brewed tea in a tulip glass"],ar:["شاي","شاي مُحضَّر في كأس تقليدي"]},
      {p:55,tr:["Ayran","Köpüklü, soğuk"],en:["Ayran","Cold, frothy yoghurt drink"],ar:["عيران","لبن رائب مخفوق بارد"]},
      {p:55,tr:["Şalgam","Acılı veya acısız, soğuk"],en:["Şalgam","Fermented turnip and carrot drink, spicy or mild"],ar:["شلغم","مشروب الشلغم المخمّر، حار أو عادي"]},
      {p:95,tr:["Limonata","Taze sıkılmış limon ve nane"],en:["Lemonade","Fresh-squeezed lemon and mint"],ar:["ليمونادة","ليمون طازج مع النعناع"]},
      {p:70,tr:["Gazlı İçecekler"],en:["Soft Drinks"],ar:["مشروبات غازية"]},
      {p:45,tr:["Soda"],en:["Soda Water"],ar:["صودا"]},
      {p:25,tr:["Su","0,5 L"],en:["Water","0.5 L"],ar:["مياه","٠٫٥ لتر"]}
    ]}
  ];
  /* ===== /MENÜ VERİSİ ===== */

  var root = document.documentElement;
  var menuEl = document.getElementById('menu');
  var navScroll = document.getElementById('navScroll');
  var nav = document.querySelector('.nav');
  var langBtns = document.querySelectorAll('.lang button');
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var lang = 'tr', chips = [], secs = [], activeIdx = -1;

  function esc(s){ return String(s).replace(/[&<>"]/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]; }); }
  function money(n){ return n.toLocaleString('tr-TR') + '\u00a0₺'; }

  function pickLang(){
    var saved = null;
    try { saved = localStorage.getItem('mardiva-lang'); } catch(e){}
    if (saved && UI[saved]) return saved;
    var nl = ((navigator.language || 'tr') + '').slice(0,2).toLowerCase();
    return UI[nl] ? nl : 'tr';
  }

  function render(){
    var rtl = lang === 'ar', t = UI[lang];
    root.lang = lang;
    root.dir = rtl ? 'rtl' : 'ltr';
    document.getElementById('title').textContent = t.menu;
    document.getElementById('note1').textContent = t.n1;
    document.getElementById('note2').textContent = t.n2;
    document.title = 'Mardiva · ' + t.menu;
    langBtns.forEach(function(b){ b.setAttribute('aria-pressed', b.dataset.lang === lang ? 'true' : 'false'); });

    var navHtml = '', html = '';
    MENU.forEach(function(c){
      navHtml += '<button type="button" class="chip" data-target="' + c.id + '">' + esc(c.name[lang]) + '</button>';
      html += '<section class="cat" id="' + c.id + '"><h2>' + esc(c.name[lang]) + '</h2>';
      c.items.forEach(function(it){
        var d = it[lang];
        var tags = (it.chef ? ['chef'] : []).concat(it.tags || []);
        html += '<article class="item"><span class="name">' + esc(d[0]) + '</span><span class="price"><bdi>' + money(it.p) + '</bdi></span>';
        if (d[1]) html += '<p class="desc">' + esc(d[1]) + '</p>';
        if (tags.length) html += '<div class="tags">' + tags.map(function(k){ return '<span class="tag' + (k === 'chef' ? ' chef' : '') + '">' + esc(t[k]) + '</span>'; }).join('') + '</div>';
        html += '</article>';
      });
      html += '</section>';
    });
    navScroll.innerHTML = navHtml;
    menuEl.innerHTML = html;
    chips = Array.prototype.slice.call(navScroll.querySelectorAll('.chip'));
    secs = Array.prototype.slice.call(menuEl.querySelectorAll('.cat'));
    root.style.setProperty('--nav-h', nav.offsetHeight + 'px');
    activeIdx = -1;
    spy(true);
  }

  function setActive(i, instant){
    if (i === activeIdx) return;
    activeIdx = i;
    chips.forEach(function(c, k){ if (k === i) c.setAttribute('aria-current','true'); else c.removeAttribute('aria-current'); });
    var c = chips[i]; if (!c) return;
    var sc = navScroll, rtl = lang === 'ar';
    var off = c.offsetLeft + c.offsetWidth / 2 - sc.clientWidth / 2;
    var left = rtl ? off - (sc.scrollWidth - sc.clientWidth) : off;
    sc.scrollTo({left: left, behavior: (reduce || instant) ? 'auto' : 'smooth'});
  }

  var ticking = false;
  function spy(instant){
    var y = nav.getBoundingClientRect().bottom + 28, cur = 0;
    secs.forEach(function(s, i){ if (s.getBoundingClientRect().top <= y) cur = i; });
    if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) cur = secs.length - 1;
    setActive(cur, instant === true);
  }
  window.addEventListener('scroll', function(){
    if (ticking) return; ticking = true;
    requestAnimationFrame(function(){ ticking = false; spy(); });
  }, {passive:true});
  window.addEventListener('resize', function(){ root.style.setProperty('--nav-h', nav.offsetHeight + 'px'); });

  navScroll.addEventListener('click', function(e){
    var b = e.target.closest('.chip'); if (!b) return;
    var s = document.getElementById(b.dataset.target);
    if (s) s.scrollIntoView({behavior: reduce ? 'auto' : 'smooth', block: 'start'});
  });

  langBtns.forEach(function(b){
    b.addEventListener('click', function(){
      lang = b.dataset.lang;
      try { localStorage.setItem('mardiva-lang', lang); } catch(e){}
      render();
    });
  });

  lang = pickLang();
  render();
})();
</script>
</body>
</html>
